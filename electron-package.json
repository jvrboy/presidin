{
  "name": "presidin-desktop",
  "version": "1.0.0",
  "description": "PRESIDIN — Unified Trading Intelligence (Desktop)",
  "main": "electron/main.js",
  "author": "PRESIDIN",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "electron:dev": "cross-env PRESIDIN_DEV=1 electron .",
    "electron:build": "bun run build && electron-builder --win --dir",
    "electron:dist": "bun run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.presidin.desktop",
    "productName": "PRESIDIN",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PRESIDIN"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "cross-env": "^7.0.3"
  }
}
