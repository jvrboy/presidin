// PRESIDIN — Prisma schema (personal app, no auth)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SignalRecord {
  id           String   @id @default(cuid())
  symbol       String
  timeframe    String
  direction    String   // BUY | SELL | NEUTRAL
  confidence   Float
  consensus    Float
  votesJson    String
  entryPrice   Float
  stopLoss     Float
  takeProfit   Float
  rrRatio      Float
  positionSize Float
  status       String   @default("active") // active | expired | executed | invalidated
  outcome      String?  // win | loss | breakeven (set after evaluation)
  evaluatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([symbol, timeframe])
  @@index([createdAt])
  @@index([status])
}

model Trade {
  id          String   @id @default(cuid())
  symbol      String
  broker      String   @default("paper")
  direction   String
  quantity    Float
  entryPrice  Float
  exitPrice   Float?
  entryTime   DateTime @default(now())
  exitTime    DateTime?
  stopLoss    Float?
  takeProfit  Float?
  pnl         Float?
  pnlPct      Float?
  status      String   @default("open")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([symbol])
  @@index([status])
}

model BotLog {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  data      String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([level])
}

model NotificationLog {
  id        String   @id @default(cuid())
  channel   String
  level     String
  title     String
  body      String
  source    String
  sentAt    DateTime @default(now())
  success   Boolean  @default(true)
}

model MlModelVersion {
  id           String   @id @default(cuid())
  modelType    String   // logistic | mlp_2layer | mlp_3layer
  version      String
  weightsJson  String
  metricsJson  String
  status       String   @default("candidate") // production | shadow | archived | candidate
  trainedAt    DateTime @default(now())
  samples      Int      @default(0)
  @@index([modelType, status])
}

model LearningStats {
  id             String   @id @default(cuid())
  totalSignals   Int      @default(0)
  correctSignals Int      @default(0)
  accuracy       Float    @default(0)
  bestStreak     Int      @default(0)
  currentStreak  Int      @default(0)
  lastRetrainedAt DateTime?
  updatedAt      DateTime @updatedAt
}
