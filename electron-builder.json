{
  "name": "PRESIDIN",
  "productName": "PRESIDIN",
  "appId": "com.presidin.desktop",
  "directories": {
    "output": "release"
  },
  "files": ["out/**/*", "electron/main.js", "electron/preload.js"],
  "mac": {
    "category": "public.app-category.finance",
    "target": ["dmg", "zip"],
    "icon": "public/icon.png"
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "public/icon.png"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office",
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}
