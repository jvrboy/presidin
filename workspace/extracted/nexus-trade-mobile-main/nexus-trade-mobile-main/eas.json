{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "applicationId": "com.app.nexustrademobile.dev",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "bundleIdentifier": "com.app.nexustrademobile.dev",
        "simulator": true
      },
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": ""
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "applicationId": "com.app.nexustrademobile.staging",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "bundleIdentifier": "com.app.nexustrademobile.staging"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": ""
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "applicationId": "com.app.nexustrademobile"
      },
      "ios": {
        "bundleIdentifier": "com.app.nexustrademobile"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": ""
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./.eas/credentials/google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    }
  }
}
