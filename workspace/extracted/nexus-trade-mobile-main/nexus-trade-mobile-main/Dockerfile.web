# Multi-stage Dockerfile for the Nexus Trade Mobile web app.
#
# Builds the Expo web export and serves it via nginx. Use this when
# you want to deploy the app as a web app to a server.
#
# Usage:
#   docker build -t nexus-trade-web:latest -f Dockerfile.web .
#   docker run -d --name nexus-web -p 80:80 nexus-trade-web:latest
#
# The web app's API_BASE_URL is configured at runtime via env var:
#   docker run -e EXPO_PUBLIC_API_BASE_URL=https://nexus-backend.example.com -p 80:80 nexus-trade-web:latest
#
# IMPORTANT: in production web deployments, you should serve the app
# from the same origin as the backend (or behind a reverse proxy that
# adds CORS headers). The dev-server /__proxy is dev-only.

# ---------- Stage 1: build ----------
FROM node:20-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

WORKDIR /app

# Cache deps separately from source.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false

# Copy source and build the web export.
COPY . .
# The web export lands in /app/dist/ after this.
RUN pnpm build:web

# ---------- Stage 2: runtime ----------
FROM nginx:alpine AS runtime

# Replace the default nginx config with a minimal SPA-serving config.
RUN rm /etc/nginx/conf.d/default.conf
COPY <<'EOF' /etc/nginx/conf.d/nexus.conf
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA routing — every unknown path falls back to index.html so
    # expo-router's client-side routes work on direct URL access.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static assets — long cache, immutable.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Security headers.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: http:; font-src 'self' data:; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;

    # Gzip + brotli compression.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1024;
    gzip_proxied any;
}
EOF

# Copy the built assets from the builder stage.
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

# Healthcheck — nginx responds 200 on /.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
